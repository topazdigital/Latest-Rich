# Nginx config for test.richdatingnetwork.com
# Place in /etc/nginx/sites-available/test.richdatingnetwork.com
# Then: ln -s /etc/nginx/sites-available/test.richdatingnetwork.com /etc/nginx/sites-enabled/
# nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name test.richdatingnetwork.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name test.richdatingnetwork.com;

    # SSL (DirectAdmin auto-installs Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/test.richdatingnetwork.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.richdatingnetwork.com/privkey.pem;

    root /home/admin/domains/test.richdatingnetwork.com/public_html;
    index index.html;

    # Proxy /api to Node.js
    location /api/ {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 50M;
    }

    # Serve uploaded files
    location /api/uploads/ {
        proxy_pass http://localhost:8080;
    }

    # SPA routing — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
