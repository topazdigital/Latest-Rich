generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  pass            String    @default("")
  password        String?
  age             Int       @default(18)
  birthday        String    @default("")
  city            String    @default("")
  country         String    @default("")
  countryCode     String    @default("") @map("country_code")
  gender          Int       @default(1)
  lat             String    @default("0")
  lng             String    @default("0")
  credits         Int       @default(0)
  premium         Int       @default(0)
  lastAccess      String    @default("0") @map("last_access")
  appId           String    @default("0") @map("app_id")
  facebookId      String    @default("0") @map("facebook_id")
  googleId        String?   @map("google_id")
  looking         Int       @default(1)
  verified        Int       @default(0)
  popular         Int       @default(0)
  lang            Int       @default(1)
  admin           Int       @default(0)
  fake            Int       @default(0)
  moderator       String?
  joinDate        String?   @map("join_date")
  joinDateTime    String    @default("0") @map("join_date_time")
  sAge            String    @default("") @map("s_age")
  sGender         Int?      @map("s_gender")
  sRadious        Int       @default(999) @map("s_radious")
  superlike       Int       @default(0)
  total           Int       @default(0)
  bio             String?   @db.LongText
  bioUrl          String?   @db.LongText @map("bio_url")
  meet            Int       @default(0)
  discover        Int       @default(0)
  guest           Int       @default(0)
  ip              String    @default("0")
  username        String    @default("")
  subscribe       Int       @default(0)
  onlineDays      String    @default("") @map("online_days")
  imported        String    @default("")
  referral        String    @default("")
  smsVerification Int       @default(0) @map("sms_verification")
  smsVerified     Int       @default(0) @map("sms_verified")
  telephone       String    @default("")
  paypal          String?
  photo           String    @default("") // main profile photo
  photoThumb      String    @default("") @map("photo_thumb")
  blocked         Int       @default(0)
  suspend         Int       @default(0)
  emailVerified   DateTime? @map("email_verified")
  resetToken      String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  photos          UserPhoto[]
  sentMessages    Chat[]       @relation("MessageSender")
  receivedMessages Chat[]     @relation("MessageReceiver")
  sentLikes       UserLike[]   @relation("LikeSender")
  receivedLikes   UserLike[]   @relation("LikeReceiver")
  visits          UserVisit[]  @relation("Visitor")
  visited         UserVisit[]  @relation("Visited")
  notifications   UserNotification[]
  credits_log     UserCredit[]
  premium_log     UserPremium[]
  orders          Order[]
  photos_likes    PhotoLike[]
  gifts_sent      UserGift[]   @relation("GiftSender")
  gifts_received  UserGift[]   @relation("GiftReceiver")
  stories         UserStory[]
  feed_posts      Feed[]
  reports_made    Report[]     @relation("Reporter")
  reports_received Report[]    @relation("Reported")
  blocks_made     UserBlock[]  @relation("Blocker")
  blocks_received UserBlock[]  @relation("Blockee")
  userExtended    UserExtended?

  @@map("users")
}

model UserExtended {
  id          Int    @id @default(autoincrement())
  userId      Int    @unique @map("user_id")
  occupation  String @default("")
  education   String @default("")
  height      String @default("")
  bodyType    String @default("") @map("body_type")
  ethnicity   String @default("")
  religion    String @default("")
  smoking     String @default("")
  drinking    String @default("")
  children    String @default("")
  relationship String @default("")
  interests   String @db.Text @default("")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("users_extended")
}

model UserPhoto {
  id        Int    @id @default(autoincrement())
  uid       Int
  photo     String
  thumb     String @default("")
  approved  Int    @default(1)
  time      Int    @default(0)
  isPrimary Int    @default(0) @map("is_primary")
  user      User   @relation(fields: [uid], references: [id], onDelete: Cascade)

  photolikes PhotoLike[]

  @@map("users_photos")
}

model PhotoLike {
  id      Int  @id @default(autoincrement())
  uid     Int
  photoId Int  @map("photo_id")
  time    Int  @default(0)
  user    User @relation(fields: [uid], references: [id], onDelete: Cascade)
  photo   UserPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([uid, photoId])
  @@map("photos_likes")
}

model Chat {
  id         Int    @id @default(autoincrement())
  u1         Int
  u2         Int
  message    String @db.Text
  time       Int    @default(0)
  read       Int    @default(0)
  from       Int    @default(0)
  type       String @default("text")
  sender     User   @relation("MessageSender", fields: [u1], references: [id], onDelete: Cascade)
  receiver   User   @relation("MessageReceiver", fields: [u2], references: [id], onDelete: Cascade)

  @@index([u1, u2])
  @@map("chat")
}

model UserChat {
  id          Int @id @default(autoincrement())
  u1          Int
  u2          Int
  lastMessage Int @default(0) @map("last_message")

  @@unique([u1, u2])
  @@map("users_chat")
}

model UserLike {
  id           Int  @id @default(autoincrement())
  u1           Int
  u2           Int
  love         Int  @default(0)
  time         Int  @default(0)
  notification Int  @default(0)
  superlike    Int  @default(0)
  sender       User @relation("LikeSender", fields: [u1], references: [id], onDelete: Cascade)
  receiver     User @relation("LikeReceiver", fields: [u2], references: [id], onDelete: Cascade)

  @@unique([u1, u2])
  @@map("users_likes")
}

model UserVisit {
  id      Int  @id @default(autoincrement())
  u1      Int
  u2      Int
  time    Int  @default(0)
  visitor User @relation("Visitor", fields: [u1], references: [id], onDelete: Cascade)
  visited User @relation("Visited", fields: [u2], references: [id], onDelete: Cascade)

  @@unique([u1, u2])
  @@map("users_visits")
}

model UserNotification {
  id      Int    @id @default(autoincrement())
  uid     Int
  type    String
  fromId  Int    @default(0) @map("from_id")
  message String @db.Text
  read    Int    @default(0)
  time    Int    @default(0)
  link    String @default("")
  user    User   @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("users_notifications")
}

model UserCredit {
  id     Int    @id @default(autoincrement())
  uid    Int
  amount Int
  type   String
  note   String @default("")
  time   Int    @default(0)
  user   User   @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("users_credits")
}

model UserPremium {
  id      Int    @id @default(autoincrement())
  uid     Int
  expire  Int    @default(0)
  type    String @default("monthly")
  user    User   @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("users_premium")
}

model Order {
  id          Int    @id @default(autoincrement())
  uid         Int
  amount      Float
  currency    String @default("USD")
  gateway     String
  gatewayId   String @default("") @map("gateway_id")
  status      String @default("pending")
  type        String @default("credits")
  package     String @default("")
  credits     Int    @default(0)
  time        Int    @default(0)
  phone       String @default("")
  countryCode String @default("") @map("country_code")
  user        User   @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Gift {
  id      Int       @id @default(autoincrement())
  name    String
  image   String
  price   Int       @default(0)
  enabled Int       @default(1)
  userGifts UserGift[]

  @@map("gifts")
}

model UserGift {
  id       Int  @id @default(autoincrement())
  fromId   Int  @map("from_id")
  toId     Int  @map("to_id")
  giftId   Int  @map("gift_id")
  time     Int  @default(0)
  read     Int  @default(0)
  from     User @relation("GiftSender", fields: [fromId], references: [id], onDelete: Cascade)
  to       User @relation("GiftReceiver", fields: [toId], references: [id], onDelete: Cascade)
  gift     Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@map("users_gift")
}

model UserStory {
  id        Int    @id @default(autoincrement())
  uid       Int
  albumId   Int    @default(0) @map("album_id")
  photo     String
  thumb     String @default("")
  time      Int    @default(0)
  user      User   @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("users_story")
}

model Feed {
  id        Int       @id @default(autoincrement())
  uid       Int
  content   String    @db.Text
  photo     String    @default("")
  time      Int       @default(0)
  privacy   String    @default("public")
  user      User      @relation(fields: [uid], references: [id], onDelete: Cascade)
  comments  FeedComment[]
  likes     FeedLike[]

  @@map("feed")
}

model FeedComment {
  id      Int    @id @default(autoincrement())
  feedId  Int    @map("feed_id")
  uid     Int
  comment String @db.Text
  time    Int    @default(0)
  feed    Feed   @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@map("feed_comments")
}

model FeedLike {
  id     Int  @id @default(autoincrement())
  feedId Int  @map("feed_id")
  uid    Int
  time   Int  @default(0)
  feed   Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, uid])
  @@map("feed_likes")
}

model Report {
  id         Int    @id @default(autoincrement())
  reporterId Int    @map("reporter_id")
  reportedId Int    @map("reported_id")
  reason     String
  details    String @default("") @db.Text
  status     String @default("pending")
  time       Int    @default(0)
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User   @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model UserBlock {
  id       Int  @id @default(autoincrement())
  blockerId Int @map("blocker_id")
  blockeeId Int @map("blockee_id")
  time     Int  @default(0)
  blocker  User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockee  User @relation("Blockee", fields: [blockeeId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockeeId])
  @@map("users_blocks")
}

model FakeMessage {
  id      Int    @id @default(autoincrement())
  message String @db.Text
  langId  Int    @default(1) @map("lang_id")

  @@map("fake_messages")
}

model Activity {
  id      Int    @id @default(autoincrement())
  aType   String @map("a_type")
  uid     Int    @default(0)
  title   String @default("")
  message String @db.Text @default("")
  time    String @default("")
  view    Int    @default(0)
  content String @default("")
  mobile  Int    @default(0)

  @@map("activity")
}

model Config {
  name           String @id
  title          String
  description    String @db.VarChar(800)
  keywords       String
  lang           String @default("1")
  videocall      String @default("")
  fbAppId        String @default("") @map("fb_app_id")
  fbAppSecret    String @default("") @map("fb_app_secret")
  theme          String @default("default")
  logo           String @default("")
  email          String @default("")
  terms          String @db.LongText @default("")
  privacy        String @db.LongText @default("")
  currency       String @default("USD")
  stripePublic   String @default("") @map("stripe_pub")
  stripeSecret   String @default("") @map("stripe_secret")
  googleKey      String @default("") @map("google_key")
  googleSecret   String @default("") @map("google_secret")
  googleMaps     String @default("") @map("google_maps")
  paypal         String @default("")
  pusherKey      String @default("") @map("pusher_key")
  pusherSecret   String @default("") @map("pusher_secret")
  pusherId       String @default("") @map("pusher_id")
  pusherCluster  String @default("us2") @map("pusher_clauster")
  freeCredits    Int    @default(50) @map("free_credits")
  freePremium    Int    @default(0) @map("free_premium")
  emailVerification Int @default(0) @map("email_verification")
  mainColor      String @default("#FF192C") @map("main_color")
  appIos         String @default("") @map("app_ios")
  appAndroid     String @default("") @map("app_android")
  css            String @db.LongText @default("") 
  js             String @db.LongText @default("")
  photoReview    Int    @default(0) @map("photo_review")
  fAI            String @default("No") @map("fAI")
  fEngage        String @default("Yes") @map("fEngage")
  fEngageTime    Int    @default(10) @map("fEngageTime")
  fEngageLimit   Int    @default(100) @map("fEngageLimit")
  fAiChance      Int    @default(30) @map("fAiChance")
  version        String @default("1.0.0")

  @@map("config")
}

model CreditPackage {
  id          Int    @id @default(autoincrement())
  credits     Int
  price       Float
  currency    String @default("USD")
  popular     Int    @default(0)
  description String @default("")
  discount    Int    @default(0)

  @@map("config_credits")
}

model PremiumPackage {
  id          Int    @id @default(autoincrement())
  name        String
  days        Int
  price       Float
  currency    String @default("USD")
  popular     Int    @default(0)
  description String @default("")

  @@map("config_premium")
}

model Interest {
  id   Int    @id @default(autoincrement())
  name String
  icon String @default("")

  @@map("interest")
}

model VideoCall {
  id     Int    @id @default(autoincrement())
  u1     Int
  u2     Int
  token  String @default("")
  time   Int    @default(0)
  status String @default("pending")

  @@map("videocall")
}

model EmailQueue {
  id        Int    @id @default(autoincrement())
  toEmail   String @map("to_email")
  subject   String
  body      String @db.LongText
  status    String @default("pending")
  time      Int    @default(0)
  attempts  Int    @default(0)

  @@map("email_queue")
}
