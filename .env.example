# ============================================================
# Rich Dating Network — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Database (PostgreSQL for dev, MySQL for production)
# PostgreSQL (Replit dev):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# MySQL (production DirectAdmin):
DATABASE_URL=mysql://admin_testdating:YOUR_PASSWORD@localhost:3306/admin_testdating

# JWT Secret (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-secret-string

# Server port
PORT=8080

# Optional: SMTP for email notifications (configure in Admin > Settings)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@richdatingnetwork.com
# SMTP_PASS=yourpassword
