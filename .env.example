# ============================================================
# Rich Dating Network — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ---- Database -----------------------------------------------
# Production (DirectAdmin MySQL):
DATABASE_URL=mysql://admin_testdating:YOUR_PASSWORD@localhost:3306/admin_testdating

# Development (Replit PostgreSQL — comment out for production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Auth ---------------------------------------------------
# Generate a strong random string: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-string

# ---- Server -------------------------------------------------
PORT=8080

# ---- Legacy uploads path ------------------------------------
# Absolute path to the old site's upload folder on the server.
# Enables /api/uploads/:filename to serve legacy photos.
# Example: /home/admin/domains/richdatingnetwork.com/public_html/assets/sources/uploads
LEGACY_UPLOADS_DIR=/home/admin/domains/richdatingnetwork.com/public_html/assets/sources/uploads

# ---- Optional: SMTP email notifications ---------------------
# SMTP_HOST=mail.richdatingnetwork.com
# SMTP_PORT=587
# SMTP_USER=noreply@richdatingnetwork.com
# SMTP_PASS=yourpassword

# ---- Optional: Google/Facebook OAuth (set in Admin > Settings) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
